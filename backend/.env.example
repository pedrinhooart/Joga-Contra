DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=SEU_USUARIO_MYSQL
DB_PASSWORD=SUA_SENHA_MYSQL
DB_NAME=joga_contra_v2
JWT_SECRET=troque-esta-chave-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=1d
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# Homologação: registros criados até esta data não são alterados pelas rotinas.
# ROTINAS_PRESERVAR_ATE=2026-11-05T14:00:00.000Z

# Pasta onde a API guarda as imagens enviadas (escudos dos times).
ARQUIVOS_DIR=arquivos

# Opcional: outro servidor Overpass (OpenStreetMap) para a busca de locais.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Atrás de um proxy (nginx, balanceador) informe quantos há (ex.: 1), para os
# limites de tentativas usarem o IP real do cliente.
# TRUST_PROXY=1

# --- Recuperação de senha por e-mail ---------------------------------------
# Gmail: use uma SENHA DE APP (16 letras), nunca a senha normal da conta.
# Crie em https://myaccount.google.com/apppasswords (exige verificação em 2 etapas).
EMAIL_PROVEDOR=gmail
EMAIL_USER=
EMAIL_PASS=
# Remetente exibido. Ex.: Joga Contra <conta.do.app@gmail.com>
EMAIL_FROM=

# Outro provedor por SMTP (Amazon SES, Resend etc.): EMAIL_PROVEDOR=smtp e
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SEGURO=false

# Endereço desta API visto pelo celular, sem /api. Vai no link do e-mail.
# Homologação: IP da máquina na rede local (ex.: http://192.168.0.10:3000).
# Produção: obrigatório https:// (ex.: https://api.seudominio.com.br).
URL_PUBLICA=

# Android App Links (produção, com domínio próprio): SHA-256 do certificado de
# assinatura do app. Publica /.well-known/assetlinks.json.
# ANDROID_PACOTE=com.jogacontra.joga_contra
# ANDROID_CERT_SHA256=
